NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Keep disabled until valid Oracle connection details are available.
ORACLE_ENABLED=false
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=ORCLPDB1
ORACLE_USER=dashboard_app
ORACLE_PASSWORD=change_me
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10
ORACLE_POOL_TIMEOUT=60

# Temporary local session. Replace the secret in every environment.
JWT_SECRET=replace_with_a_long_random_secret
AUTH_SESSION_TTL_SECONDS=28800
AUTH_COOKIE_SECURE=false
MENU_ADMIN_CODE=MENU_MANAGEMENT
ADMIN_GROUP_IDS=0

# Reserved for the VNPT SSO integration phase.
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
